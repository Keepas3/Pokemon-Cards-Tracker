# SQLite database file (relative to project root). On a host with a persistent
# volume, point it there, e.g. file:/data/app.db
DATABASE_URL="file:./prisma/dev.db"

# The one data key: set lists, set contents and market prices.
# Free key from https://tcgapi.dev/
TCGAPI_DEV_API_KEY=""

# --- Sign-in (required once the site is hosted; recommended everywhere) ---

# Signs the "stay signed in" cookie. Any long random string (32+ characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the app refuses to serve pages without it. Changing it signs everyone out.
SESSION_SECRET=""

# The people who share the site, each with their own password (8+ characters). Applied at
# startup: it creates missing profiles, and the first name takes over the collection that
# existed before profiles did. It never replaces a password that's already set. To reset a
# forgotten one: on your own machine run  npm run profile:set -- "Name" "new password";
# on a host with no shell, put the new password here, set BOOTSTRAP_OVERWRITE=1 for one
# deploy, then remove that flag again.
# Short form "Name:password,Name2:password2" (no commas in passwords), or JSON:
#   [{"name":"Sam","password":"…"},{"name":"Alex","password":"…"}]
BOOTSTRAP_PROFILES=""
# BOOTSTRAP_OVERWRITE=1

# Optional. The app only answers requests addressed to localhost / 127.0.0.1.
# To reach it by another name (your host's domain, a Tailscale name, your PC's LAN
# address), list it here, comma-separated — and read "Security model" in the README first.
# ALLOWED_HOSTS=my-app.up.railway.app
